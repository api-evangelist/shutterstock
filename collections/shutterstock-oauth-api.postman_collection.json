          "id": "3d8f06f2-03ff-40d8-9cd4-f884a1d27b63",
          "name": "Authorize applications",
          "request": {
            "name": "Authorize applications",
            "description": {
              "content": "This endpoint returns a redirect URI (in the 'Location' header) that the customer uses to authorize your application and, together with POST /v2/oauth/access_token, generate an access token that represents that authorization.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "oauth",
                "authorize"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) Client ID (Consumer Key) of your application"
                },
                {
                  "disabled": false,
                  "key": "realm",
                  "value": "customer",
                  "description": "User type to be authorized (usually 'customer')"
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<string>",
                  "description": "(Required) The callback URI to send the request to after authorization; must use a host name that is registered with your application"
                },
                {
                  "disabled": false,
                  "key": "response_type",
                  "value": "<string>",
                  "description": "(Required) Type of temporary authorization code that will be used to generate an access code; the only valid value is 'code'"
                },
                {
                  "disabled": false,
                  "key": "scope",
                  "value": "user.view",
                  "description": "Space-separated list of scopes to be authorized"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "(Required) Unique value used by the calling app to verify the request"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/html"
              }
            ],
            "method": "GET",
